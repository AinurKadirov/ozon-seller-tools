# Copy to backend/.env.development (do not commit).
MONGO_URL=mongodb://127.0.0.1:27017/ozon
LOG_LEVEL=debug
LOG_FORMAT=pretty
BACKEND_PORT=3000

# Ozon Seller API
OZON_SELLER_CLIENT_ID=
OZON_SELLER_API_KEY=
OZON_PERFORMANCE_CLIENT_ID=
OZON_PERFORMANCE_CLIENT_SECRET=
OZON_ACCOUNT_ID=

# Optional: second shop / WB
OZON_SELLER_CLIENT_ID_MILAI=
OZON_SELLER_API_KEY_MILAI=
LUMOS_TOKEN_WB=
MILAI_TOKEN_WB=

# Optional alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
